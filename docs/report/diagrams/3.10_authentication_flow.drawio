<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Authentication Flow - Multi-Method" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="200" y="10" width="360" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="start" value="User visits&lt;br&gt;Login / Register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="270" y="60" width="160" height="45" as="geometry"/>
    </mxCell>

    <mxCell id="d1" value="Auth&lt;br&gt;Method?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="305" y="140" width="90" height="80" as="geometry"/>
    </mxCell>

    <!-- Email + OTP -->
    <mxCell id="m1_1" value="Enter Email + Password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="80" y="280" width="160" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="m1_2" value="Verify credentials&lt;br&gt;(bcrypt compare)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="80" y="340" width="160" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="m1_3" value="Send OTP to email&lt;br&gt;(Nodemailer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="80" y="405" width="160" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="m1_4" value="User enters OTP&lt;br&gt;Verify against hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="80" y="470" width="160" height="40" as="geometry"/>
    </mxCell>

    <!-- Google OAuth -->
    <mxCell id="m2_1" value="Redirect to&lt;br&gt;Google OAuth 2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="460" y="280" width="160" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="m2_2" value="Google returns&lt;br&gt;profile + token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="460" y="350" width="160" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="m2_3" value="Find or create&lt;br&gt;user account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="460" y="420" width="160" height="35" as="geometry"/>
    </mxCell>

    <!-- Labels -->
    <mxCell id="lbl1" value="Email + OTP" style="text;html=1;fontSize=10;fontStyle=3;align=center;" vertex="1" parent="1">
      <mxGeometry x="110" y="250" width="100" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="lbl2" value="Google OAuth" style="text;html=1;fontSize=10;fontStyle=3;align=center;" vertex="1" parent="1">
      <mxGeometry x="490" y="250" width="100" height="20" as="geometry"/>
    </mxCell>

    <!-- Common: JWT -->
    <mxCell id="jwt" value="Generate JWT Token&lt;br&gt;(role, user_id, email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="235" y="540" width="230" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="store" value="Store in localStorage&lt;br&gt;(Redux Persist)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="255" y="615" width="190" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="redirect" value="Redirect to role-based&lt;br&gt;dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="255" y="680" width="190" height="40" as="geometry"/>
    </mxCell>

    <!-- Edges -->
    <mxCell id="ef0" edge="1" parent="1" source="start" target="d1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef1" edge="1" parent="1" source="d1" target="m1_1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef2" edge="1" parent="1" source="d1" target="m2_1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef4" edge="1" parent="1" source="m1_1" target="m1_2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef5" edge="1" parent="1" source="m1_2" target="m1_3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef6" edge="1" parent="1" source="m1_3" target="m1_4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef7" edge="1" parent="1" source="m1_4" target="jwt" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef8" edge="1" parent="1" source="m2_1" target="m2_2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef9" edge="1" parent="1" source="m2_2" target="m2_3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef10" edge="1" parent="1" source="m2_3" target="jwt" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef14" edge="1" parent="1" source="jwt" target="store" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef15" edge="1" parent="1" source="store" target="redirect" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
