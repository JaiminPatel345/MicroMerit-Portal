<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Credential Verification Flow - Dual Method" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="250" y="10" width="500" height="30" as="geometry"/>
    </mxCell>

    <!-- Start -->
    <mxCell id="start" value="Verifier accesses /verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="370" y="60" width="200" height="40" as="geometry"/>
    </mxCell>

    <!-- Decision: Which method? -->
    <mxCell id="d1" value="Choose&lt;br&gt;Method" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="415" y="130" width="110" height="80" as="geometry"/>
    </mxCell>

    <!-- LEFT: Blockchain Verification -->
    <mxCell id="bc_title" value="Method 1: Blockchain Verification" style="text;html=1;fontSize=13;fontStyle=5;align=center;" vertex="1" parent="1">
      <mxGeometry x="20" y="230" width="300" height="25" as="geometry"/>
    </mxCell>

    <mxCell id="bc_d1" value="Input&lt;br&gt;Type?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="120" y="270" width="90" height="70" as="geometry"/>
    </mxCell>

    <!-- Sub-method A: By Identifier -->
    <mxCell id="bc_a1" value="Provide credential_id&lt;br&gt;or tx_hash or ipfs_cid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="370" width="170" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="bc_a2" value="Fetch credential from DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="30" y="440" width="150" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="bc_a3" value="Rebuild Canonical JSON&lt;br&gt;(ipfs_cid, tx_hash = null)&lt;br&gt;Sort keys, SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="15" y="500" width="180" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="bc_a4" value="Compare with stored&lt;br&gt;data_hash = hash_match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="30" y="580" width="150" height="70" as="geometry"/>
    </mxCell>

    <!-- Sub-method B: By PDF -->
    <mxCell id="bc_b1" value="Upload original PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="230" y="370" width="140" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="bc_b2" value="Extract credential_id&lt;br&gt;from PDF Keywords" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="220" y="430" width="160" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="bc_b3" value="SHA-256 of PDF buffer&lt;br&gt;Compare with stored checksum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="210" y="500" width="180" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="bc_b4" value="checksum_match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="230" y="580" width="140" height="60" as="geometry"/>
    </mxCell>

    <!-- Blockchain verify common step -->
    <mxCell id="bc_c1" value="Query Smart Contract&lt;br&gt;on Sepolia via tx_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="110" y="680" width="190" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="bc_c2" value="blockchain_verified?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="130" y="750" width="150" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="bc_valid" value="VALID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="840" width="80" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="bc_invalid" value="INVALID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="230" y="840" width="80" height="35" as="geometry"/>
    </mxCell>

    <!-- RIGHT: AI Verification -->
    <mxCell id="ai_title" value="Method 2: AI Verification" style="text;html=1;fontSize=13;fontStyle=5;align=center;" vertex="1" parent="1">
      <mxGeometry x="580" y="230" width="250" height="25" as="geometry"/>
    </mxCell>

    <mxCell id="ai1" value="Provide Credential ID +&lt;br&gt;Upload any copy (scan, photo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="270" width="220" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="ai2" value="Fetch original PDF&lt;br&gt;from IPFS via ipfs_cid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="575" y="350" width="190" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="ai3" value="Send both documents to&lt;br&gt;Google Gemini 2.5 Flash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="565" y="425" width="210" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="ai4" value="Field-by-field comparison:&lt;br&gt;name, institution, course,&lt;br&gt;marks, dates, roll no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="500" width="220" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="ai5" value="Returns:&lt;br&gt;match (true/false)&lt;br&gt;confidence (0-100%)&lt;br&gt;mismatches list&lt;br&gt;summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="575" y="590" width="190" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="ai_note" value="Note: AI is probabilistic,&lt;br&gt;not legal proof" style="text;html=1;fontSize=9;fontStyle=2;align=center;" vertex="1" parent="1">
      <mxGeometry x="585" y="690" width="170" height="30" as="geometry"/>
    </mxCell>

    <!-- Edges -->
    <mxCell id="fe0" edge="1" parent="1" source="start" target="d1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe1" edge="1" parent="1" source="d1" target="bc_d1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" value="Blockchain">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe2" edge="1" parent="1" source="d1" target="ai1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" value="AI">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Blockchain sub-flows -->
    <mxCell id="fe3" edge="1" parent="1" source="bc_d1" target="bc_a1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" value="ID">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe4" edge="1" parent="1" source="bc_d1" target="bc_b1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" value="PDF">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe5" edge="1" parent="1" source="bc_a1" target="bc_a2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe6" edge="1" parent="1" source="bc_a2" target="bc_a3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe7" edge="1" parent="1" source="bc_a3" target="bc_a4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe8" edge="1" parent="1" source="bc_b1" target="bc_b2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe9" edge="1" parent="1" source="bc_b2" target="bc_b3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe10" edge="1" parent="1" source="bc_b3" target="bc_b4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe11" edge="1" parent="1" source="bc_a4" target="bc_c1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" value="Yes">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe12" edge="1" parent="1" source="bc_b4" target="bc_c1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" value="Yes">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe13" edge="1" parent="1" source="bc_c1" target="bc_c2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe14" edge="1" parent="1" source="bc_c2" target="bc_valid" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0;exitY=1;exitDx=0;exitDy=0;" value="Yes">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="fe15" edge="1" parent="1" source="bc_c2" target="bc_invalid" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=1;exitY=1;exitDx=0;exitDy=0;" value="No">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- AI flow edges -->
    <mxCell id="ae1" edge="1" parent="1" source="ai1" target="ai2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ae2" edge="1" parent="1" source="ai2" target="ai3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ae3" edge="1" parent="1" source="ai3" target="ai4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ae4" edge="1" parent="1" source="ai4" target="ai5" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>