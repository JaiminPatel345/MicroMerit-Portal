<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="External Credential Sync - Connector Pattern" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="150" y="10" width="500" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="learner" value="Learner triggers&lt;br&gt;External Sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="60" width="200" height="45" as="geometry"/>
    </mxCell>

    <mxCell id="backend" value="Main Backend API&lt;br&gt;(External Sync Module)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="265" y="145" width="230" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="factory" value="ConnectorFactory&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Selects provider-specific connector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="255" y="240" width="250" height="50" as="geometry"/>
    </mxCell>

    <!-- Connectors (evenly spaced, no overlap) -->
    <mxCell id="conn_udemy" value="Udemy&lt;br&gt;Connector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="100" y="350" width="140" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="conn_credly" value="Credly&lt;br&gt;Connector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="310" y="350" width="140" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="conn_future" value="... Future&lt;br&gt;Connectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="520" y="350" width="140" height="50" as="geometry"/>
    </mxCell>

    <!-- Provider API box -->
    <mxCell id="adapter_box" value="Credential Provider Adapter Interface (Port 4000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="60" y="450" width="640" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="prov_udemy" value="Udemy API&lt;br&gt;(Course Certs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="100" y="480" width="140" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="prov_credly" value="Credly API&lt;br&gt;(Digital Badges)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="480" width="140" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="normalize" value="Normalize to standard&lt;br&gt;Credential schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="245" y="600" width="270" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="decide" value="Existing&lt;br&gt;User?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="330" y="680" width="100" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="link" value="Link credential&lt;br&gt;to learner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="140" y="780" width="150" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="pending" value="Create pending claim&lt;br&gt;+ send email invite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="480" y="780" width="170" height="40" as="geometry"/>
    </mxCell>

    <!-- Edges (clean, no crossings) -->
    <mxCell id="ef1" edge="1" parent="1" source="learner" target="backend" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef2" edge="1" parent="1" source="backend" target="factory" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef4" edge="1" parent="1" source="factory" target="conn_udemy" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef5" edge="1" parent="1" source="factory" target="conn_credly" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef5b" edge="1" parent="1" source="factory" target="conn_future" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef7" edge="1" parent="1" source="conn_udemy" target="prov_udemy" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef8" edge="1" parent="1" source="conn_credly" target="prov_credly" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef10" edge="1" parent="1" source="prov_udemy" target="normalize" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="170" y="570"/>
          <mxPoint x="299" y="570"/>
          <mxPoint x="299" y="645"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="ef11" edge="1" parent="1" source="prov_credly" target="normalize" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="380" y="570"/>
          <mxPoint x="380" y="645"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="ef12" edge="1" parent="1" source="normalize" target="decide" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef13" edge="1" parent="1" source="decide" target="link" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Yes">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef14" edge="1" parent="1" source="decide" target="pending" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="No">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
