<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="MicroMerit Portal - System Architecture" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="300" y="10" width="500" height="40" as="geometry"/>
    </mxCell>

    <!-- CLIENT LAYER -->
    <mxCell id="CL" value="CLIENT LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="100" y="70" width="600" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="c1" value="Main App (Frontend)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;React + Vite + Tailwind | Port 5173&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="130" y="100" width="240" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="c2" value="Admin Dashboard&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;React + Vite + TS | Port 5174&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="430" y="100" width="240" height="60" as="geometry"/>
    </mxCell>

    <!-- SERVER LAYER - all 4 services in a row with gaps -->
    <mxCell id="SL" value="SERVER LAYER (MICROSERVICES)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="270" width="1130" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="s1" value="Main Backend API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Node + Express + TS&lt;br&gt;Port 3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="310" width="230" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="AI Service&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Python + FastAPI&lt;br&gt;Port 8000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="340" y="310" width="200" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="Blockchain Service&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Hardhat + Ethers.js&lt;br&gt;Port 3001&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="310" width="220" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="Credential Provider&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Adapter Interface&lt;br&gt;Port 4000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="880" y="310" width="220" height="70" as="geometry"/>
    </mxCell>

    <!-- DATA LAYER - aligned below respective services -->
    <mxCell id="DL" value="DATA AND STORAGE LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="480" width="900" height="130" as="geometry"/>
    </mxCell>
    <!-- PostgreSQL directly below Main Backend -->
    <mxCell id="d1" value="PostgreSQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="70" y="520" width="140" height="70" as="geometry"/>
    </mxCell>
    <!-- Redis below between Backend and AI -->
    <mxCell id="d2" value="Redis + BullMQ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="270" y="520" width="150" height="70" as="geometry"/>
    </mxCell>
    <!-- IPFS below AI Service area -->
    <mxCell id="d3" value="IPFS" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="490" y="520" width="140" height="70" as="geometry"/>
    </mxCell>
    <!-- Ethereum Sepolia directly below Blockchain Service -->
    <mxCell id="d4" value="Ethereum Sepolia&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CredentialRegistry&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="515" width="170" height="80" as="geometry"/>
    </mxCell>

    <!-- EXTERNAL SERVICES -->
    <mxCell id="EL" value="EXTERNAL SERVICES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="690" width="900" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="x1" value="Google OAuth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="725" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="x2" value="DigiLocker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="230" y="725" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="x3" value="Groq API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="400" y="725" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="x4" value="Google Gemini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="570" y="725" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="x5" value="Nodemailer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="740" y="725" width="120" height="40" as="geometry"/>
    </mxCell>

    <!-- ===== EDGES ===== -->

    <!-- Client to Main Backend: straight down, orthogonal -->
    <mxCell id="e1" edge="1" parent="1" source="c1" target="s1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" value="REST API">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" edge="1" parent="1" source="c2" target="s1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" value="REST API">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Server-to-server: horizontal orthogonal with staggered Y exits -->
    <mxCell id="e3" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=1.5;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" value="HTTP">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="HTTP">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e5" edge="1" parent="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Backend to data: straight down orthogonal, each to its aligned store -->
    <mxCell id="e6" edge="1" parent="1" source="s1" target="d1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=1.5;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Prisma">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e7" edge="1" parent="1" source="s1" target="d2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=1.5;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="BullMQ">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Backend to IPFS: route right then down, avoid crossing AI box -->
    <mxCell id="e8" edge="1" parent="1" source="s2" target="d3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="S3 API">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Blockchain to Sepolia: straight down -->
    <mxCell id="e9" edge="1" parent="1" source="s3" target="d4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="Ethers.js">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Data to External: straight down, each aligned -->
    <mxCell id="e10" edge="1" parent="1" source="d1" target="x1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e11" edge="1" parent="1" source="d2" target="x2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e12" edge="1" parent="1" source="d3" target="x3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;dashed=1;strokeColor=#999999;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e13" edge="1" parent="1" source="d3" target="x4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;dashed=1;strokeColor=#999999;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e14" edge="1" parent="1" source="d4" target="x5" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>