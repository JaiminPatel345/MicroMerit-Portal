<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Figure 3.5: DFD Level 1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="350" y="10" width="500" height="40" as="geometry"/>
    </mxCell>

    <!-- Processes (circles) -->
    <mxCell id="p1" value="1.0&lt;br&gt;&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;Module" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="80" y="80" width="160" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="p2" value="2.0&lt;br&gt;&lt;b&gt;Credential&lt;/b&gt;&lt;br&gt;&lt;b&gt;Issuance&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="400" y="80" width="160" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="p3" value="3.0&lt;br&gt;&lt;b&gt;Blockchain&lt;/b&gt;&lt;br&gt;&lt;b&gt;Anchoring&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="80" width="160" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="p4" value="4.0&lt;br&gt;&lt;b&gt;Verification&lt;/b&gt;&lt;br&gt;(Blockchain + AI)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="80" y="300" width="170" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="p5" value="5.0&lt;br&gt;&lt;b&gt;External Sync&lt;/b&gt;&lt;br&gt;(Connector Pattern)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="400" y="300" width="170" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="p6" value="6.0&lt;br&gt;&lt;b&gt;Employer&lt;/b&gt;&lt;br&gt;&lt;b&gt;Search + AI&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="300" width="160" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="p7" value="7.0&lt;br&gt;&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;&lt;b&gt;Management&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="400" y="520" width="160" height="90" as="geometry"/>
    </mxCell>

    <!-- Data Stores (open rectangles) -->
    <mxCell id="ds1" value="D1  PostgreSQL Database" style="shape=partialRectangle;top=0;left=0;bottom=1;right=0;fillColor=none;strokeColor=default;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="490" width="220" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="ds2" value="D2  IPFS Storage" style="shape=partialRectangle;top=0;left=0;bottom=1;right=0;fillColor=none;strokeColor=default;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="490" width="180" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="ds3" value="D3  Ethereum Blockchain" style="shape=partialRectangle;top=0;left=0;bottom=1;right=0;fillColor=none;strokeColor=default;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="550" width="210" height="30" as="geometry"/>
    </mxCell>

    <!-- External Entities -->
    <mxCell id="ext_user" value="User (All Roles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="200" width="140" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="ext_prov" value="External Providers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="420" y="430" width="150" height="40" as="geometry"/>
    </mxCell>

    <!-- Key Flows -->
    <mxCell id="df1" edge="1" parent="1" source="ext_user" target="p1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;" value="Credentials">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="df2" edge="1" parent="1" source="p1" target="p2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;" value="Authenticated User">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="df3" edge="1" parent="1" source="p2" target="p3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;" value="Credential + PDF">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- df4: p3 to ds3 (data_hash) - route RIGHT of p6 to avoid passing through it -->
    <mxCell id="df4" edge="1" parent="1" source="p3" target="ds3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="data_hash">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="950" y="143"/>
          <mxPoint x="950" y="565"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- df5: p3 to ds2 (PDF) - route RIGHT of p6 to avoid passing through it -->
    <mxCell id="df5" edge="1" parent="1" source="p3" target="ds2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="PDF">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="920" y="107"/>
          <mxPoint x="920" y="505"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- df6: p2 to ds1 (Credential Record) - route BELOW ext_user via far-left corridor -->
    <mxCell id="df6" edge="1" parent="1" source="p2" target="ds1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="Credential Record">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="480" y="260"/>
          <mxPoint x="50" y="260"/>
          <mxPoint x="50" y="505"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="df7" edge="1" parent="1" source="ext_user" target="p4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;" value="Verify Request">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="df8" edge="1" parent="1" source="p4" target="ds1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;" value="Lookup">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="df9" edge="1" parent="1" source="p5" target="ext_prov" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;" value="API Request">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- df10: p6 to ds1 (Query) - route below ext_prov via horizontal band at y=475 -->
    <mxCell id="df10" edge="1" parent="1" source="p6" target="ds1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="Query">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="800" y="475"/>
          <mxPoint x="300" y="475"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="df11" edge="1" parent="1" source="p7" target="ds1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;" value="CRUD">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
