<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Figure 3.9: Bulk Issuance – Adapter Pattern Flow" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="200" y="10" width="500" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="s1" value="Issuer uploads ZIP file&lt;br&gt;(JSON credential files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="310" y="60" width="220" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="Create BulkUploadBatch record&lt;br&gt;(status: processing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="140" width="220" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="Extract files from ZIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="340" y="220" width="160" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="For each file:" style="text;html=1;fontSize=12;fontStyle=3;align=center;" vertex="1" parent="1">
      <mxGeometry x="370" y="280" width="100" height="20" as="geometry"/>
    </mxCell>

    <!-- Adapter Pattern Box -->
    <mxCell id="adapter_box" value="IssuerBulkAdapterFactory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="170" y="310" width="500" height="250" as="geometry"/>
    </mxCell>

    <mxCell id="a1" value="identify()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Detect file type (JSON/PDF/Image)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="200" y="350" width="200" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="a2" value="extractMetadata()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Parse JSON / OCR via AI service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="440" y="350" width="200" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="a3" value="verify()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Validate credential data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="200" y="430" width="200" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="a4" value="normalize()&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Map to standard Credential schema&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="440" y="430" width="200" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="a5" value="DefaultAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="330" y="510" width="180" height="30" as="geometry"/>
    </mxCell>

    <!-- Post-adapter steps -->
    <mxCell id="s5" value="Build Canonical JSON + data_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="305" y="590" width="230" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="s6" value="Anchor to Blockchain + Upload to IPFS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="300" y="660" width="240" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="s7" value="Update batch:&lt;br&gt;success_count / failed_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="730" width="220" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s8" value="Batch Complete&lt;br&gt;(Polling UI shows progress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="800" width="200" height="45" as="geometry"/>
    </mxCell>

    <!-- Edges -->
    <mxCell id="ef1" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef2" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef3" edge="1" parent="1" source="s3" target="a1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef4" edge="1" parent="1" source="a1" target="a2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef5" edge="1" parent="1" source="a2" target="a3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="540" y="415"/>
          <mxPoint x="300" y="415"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="ef6" edge="1" parent="1" source="a3" target="a4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef7" edge="1" parent="1" source="a4" target="s5" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef8" edge="1" parent="1" source="s5" target="s6" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ef9" edge="1" parent="1" source="s6" target="s7" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
