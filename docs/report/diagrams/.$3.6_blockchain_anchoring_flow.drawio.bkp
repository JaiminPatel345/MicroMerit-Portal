<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="Figure 3.6: Credential Issuance and Blockchain Anchoring Flow" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="100" y="10" width="750" height="30" as="geometry"/>
    </mxCell>

    <!-- Start -->
    <mxCell id="start" value="" style="ellipse;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="450" y="50" width="30" height="30" as="geometry"/>
    </mxCell>

    <!-- Steps -->
    <mxCell id="s1" value="Issuer submits&lt;br&gt;Credential (PDF + Metadata)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="360" y="100" width="210" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="Generate credential_id (UUID v4)&lt;br&gt;Embed in PDF Keywords using pdf-lib" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="340" y="180" width="250" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="SHA-256 of modified PDF = checksum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="260" width="230" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="Build Canonical JSON&lt;br&gt;(fixed fields, ipfs_cid=null, tx_hash=null)&lt;br&gt;Sort keys recursively alphabetically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="330" y="330" width="270" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="s5" value="SHA-256 of Canonical JSON = data_hash&lt;br&gt;(64-char hex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="340" y="420" width="250" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="s6" value="Save to PostgreSQL&lt;br&gt;blockchain_status: pending&lt;br&gt;ipfs_status: pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="495" width="230" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="s7" value="Return HTTP Response&lt;br&gt;(Immediate - user does not wait)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="580" width="230" height="45" as="geometry"/>
    </mxCell>

    <!-- Background Job Split -->
    <mxCell id="split_label" value="Background Jobs (setImmediate)" style="text;html=1;fontSize=12;fontStyle=3;align=center;" vertex="1" parent="1">
      <mxGeometry x="300" y="650" width="330" height="25" as="geometry"/>
    </mxCell>

    <!-- Left branch: Blockchain -->
    <mxCell id="b1" value="POST /blockchain/write&lt;br&gt;(Blockchain Service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="120" y="700" width="200" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="b2" value="Smart Contract:&lt;br&gt;issueCredential(&lt;br&gt;credential_id, dataHash, ipfsCid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="775" width="240" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="b3" value="Receive tx_hash&lt;br&gt;Update DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="140" y="860" width="160" height="40" as="geometry"/>
    </mxCell>

    <!-- Right branch: IPFS -->
    <mxCell id="i1" value="Upload PDF to IPFS&lt;br&gt;(S3-compatible API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="700" width="200" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="i2" value="Receive ipfs_cid + pdf_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="570" y="775" width="180" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="i3" value="Update DB with&lt;br&gt;ipfs_cid, pdf_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="580" y="845" width="160" height="40" as="geometry"/>
    </mxCell>

    <!-- End -->
    <mxCell id="end_box" value="Credential Fully Anchored&lt;br&gt;(blockchain_status: confirmed, ipfs_status: stored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="290" y="930" width="350" height="45" as="geometry"/>
    </mxCell>

    <!-- Edges -->
    <mxCell id="f0" edge="1" parent="1" source="start" target="s1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f1" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f2" edge="1" parent="1" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f3" edge="1" parent="1" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f4" edge="1" parent="1" source="s4" target="s5" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f5" edge="1" parent="1" source="s5" target="s6" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f6" edge="1" parent="1" source="s6" target="s7" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f7" edge="1" parent="1" source="s7" target="b1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f8" edge="1" parent="1" source="s7" target="i1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f9" edge="1" parent="1" source="b1" target="b2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f10" edge="1" parent="1" source="b2" target="b3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f11" edge="1" parent="1" source="i1" target="i2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f12" edge="1" parent="1" source="i2" target="i3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f13" edge="1" parent="1" source="b3" target="end_box" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f14" edge="1" parent="1" source="i3" target="end_box" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>